@page
@model IndexModel
@{
    ViewData["Title"] = "Panel Principal";
}

<div class="container mt-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border-0">
        <div class="container-fluid py-2">
            <h1 class="display-5 fw-bold text-dark">¡Bienvenido, @Model.NombreUsuario!</h1>
            <p class="col-md-8 fs-4 text-secondary">Has ingresado como perfil: <span class="badge bg-primary text-uppercase">@Model.RolUsuario</span></p>
            <hr class="my-4">
            <a class="btn btn-outline-danger fw-bold" asp-page="/Login">Cerrar Sesión</a>
        </div>
    </div>

    @* VISTA PANEL: ADMINISTRADOR *@
    @if (Model.RolUsuario == "Administrador")
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h4 class="card-title fw-bold text-primary mb-3">Consola del Administrador</h4>
                        <p class="text-muted">Desde aquí podrás gestionar clientes, instructores y auditar los informes del gimnasio.</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-primary fw-bold" asp-page="/AdminDashboard">📋 Abrir Consola de Gestión (Clientes e Instructores)</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* VISTA PANEL: CLIENTE *@
    @if (Model.RolUsuario == "Cliente")
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm bg-dark text-white">
                    <div class="card-body">
                        <h4 class="card-title fw-bold text-warning mb-3">Zona de Atletas</h4>
                        <p>Solicita tus turnos diarios y consulta tu historial de entrenamiento.</p>
                        <a class="btn btn-warning fw-bold text-dark" asp-page="/ClienteDashboard">🕒 Agendar Turno de Hoy</a>
                    </div>
                </div>
            </div>
        </div>
    }

    @* VISTA PANEL: INSTRUCTOR *@
    @if (Model.RolUsuario == "Instructor")
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm bg-info text-dark">
                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3">Portal de Instructores</h4>
                        <p>Revisa tus clientes asignados en la cola del día y asígnales rutinas.</p>
                        <a class="btn btn-dark fw-bold" asp-page="/InstructorDashboard">💪 Ver mis Clientes en Fila</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>